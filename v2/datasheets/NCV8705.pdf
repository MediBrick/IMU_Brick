         <pdf:Producer>Acrobat Distiller 24.0 (Windows)</pdf:Producer>
         <pdf:Keywords/>
         <xmp:CreatorTool>BroadVision, Inc.</xmp:CreatorTool>
         <xmp:ModifyDate>2024-07-03T08:42:32+02:00</xmp:ModifyDate>
