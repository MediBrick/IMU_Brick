         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NCV8705 - LDO Regulator - Ultra-Low, Quiescent Current, IQ 13  A, Ultra-Low Noise 500 mA</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The NCV8705 is a low noise, low power consumption and low dropout Linear Voltage Regulator. With its excellent noise and PSRR&#xA;specifications, the device is ideal for use in products utilizing RF receivers, imaging sensors, audio processors or any component requiring an extremely clean power supply. The NCV8705 uses an innovative Adaptive Ground Current circuit to ensure ultra low ground current during light load conditions.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:1d135ab1-3fca-49c8-bc08-bd5ab9bf40b4</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:3093c825-2fca-41d3-9d83-5285bc0dc128</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
